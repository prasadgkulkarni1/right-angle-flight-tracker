# Flight Tracker Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git!

# =============================================================================
# REQUIRED - Claude AI for Natural Language Processing
# =============================================================================
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# =============================================================================
# OPTIONAL - Flight Data Providers
# =============================================================================

# Amadeus Flight Data API (Real flight data)
# Get credentials from: https://developers.amadeus.com/
# Free tier: 2000 requests/month
AMADEUS_API_KEY=your-amadeus-api-key
AMADEUS_API_SECRET=your-amadeus-api-secret

# Add more providers here as they are implemented
# SKYSCANNER_API_KEY=your-skyscanner-key
# KAYAK_API_KEY=your-kayak-key

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Port for web server (default: 5000)
# Change if port 5000 is already in use
PORT=5000

# =============================================================================
# NOTES
# =============================================================================
#
# 1. Mock Provider:
#    - No API keys needed
#    - Always available for testing
#    - Generates random flight prices
#
# 2. Amadeus Provider:
#    - Requires AMADEUS_API_KEY and AMADEUS_API_SECRET
#    - Provides real-time flight data
#    - Rate limits apply
#
# 3. To use this file:
#    cp .env.example .env
#    # Edit .env with your actual keys
#    # Make sure .env is in .gitignore!
#
# 4. Loading variables:
#    - CLI: Variables are loaded automatically from environment
#    - Python: Use python-dotenv package
#      pip install python-dotenv
#      from dotenv import load_dotenv; load_dotenv()
#
# 5. Security:
#    - Never commit .env to git
#    - Never share API keys publicly
#    - Rotate keys regularly
#    - Use different keys for dev/staging/prod
